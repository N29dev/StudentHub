@page "/"
@inject HubStore Store
<PageTitle>Overview · StudentHub</PageTitle>

<header class="page-head">
    <div><p class="eyebrow">@DateTime.Today.ToString("dddd, d MMMM yyyy")</p><h1>Overview</h1>
    <p>Keep track of your semester.</p></div>
    <a class="button" href="/assignments">Manage assignments</a>
</header>
@{
    var data = Store.Data;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var pending = data.Assignments.Count(a => !a.Completed);
    var done = data.Assignments.Count(a => a.Completed);
    var late = data.Assignments.Count(a => a.Status(today) == TaskStatus.Overdue);
    var percent = data.Assignments.Length == 0 ? 0 : 100 * done / data.Assignments.Length;
}
<div class="stats">
    <Stat Label="Current GPA" Value="@(data.Courses.Gpa()?.ToString("0.00") ?? "—")" Detail="out of 4.00" />
    <Stat Label="Due assignments" Value="@pending.ToString()" Detail="@($"{late} overdue")" />
    <Stat Label="Completed" Value="@($"{percent}%")" Detail="@($"{done} of {data.Assignments.Length} tasks")" />
    <Stat Label="Credits" Value="@data.Courses.Sum(c => c.Credits).ToString()" Detail="@($"{data.Courses.Length} courses")" />
</div>
<Notice Message="@error" />
<div class="dashboard">
    <section class="panel">
        <div class="section-head"><div><h2>Up next</h2><p>Ranked by urgency and importance.</p></div>
            <a href="/assignments">All tasks →</a></div>
        <TaskList Items="@data.Assignments.Plan(today).Take(5).ToArray()" Data="@data"
                  Today="@today" Toggle="Toggle" />
    </section>
    <section class="panel">
        <div class="section-head"><div><h2>Today's classes</h2><p>@today.ToString("dddd")</p></div>
            <a href="/timetable">Schedule →</a></div>
        @foreach (var l in data.Lessons.Where(l => l.Day == today.DayOfWeek).OrderBy(l => l.Start))
        {
            <div class="lesson-row"><strong>@data.CourseName(l.CourseId)</strong>
                <small>@l.Start.ToString("HH:mm") – @l.End.ToString("HH:mm") · @l.Room</small></div>
        }
        @if (!data.Lessons.Any(l => l.Day == today.DayOfWeek))
        {
            <p class="empty">No classes scheduled today.</p>
        }
    </section>
    <section class="panel wide">
        <div class="section-head"><div><h2>Course progress</h2><p>Completed assignments by course.</p></div>
            <a href="/courses">All courses →</a></div>
        @foreach (var p in data.Progress())
        {
            <div class="progress-row">
                <div><strong>@p.Course.Name</strong><small>@p.Done / @p.Total tasks</small></div>
                <progress value="@p.Done" max="@Math.Max(1, p.Total)" aria-label="@p.Course.Name"></progress>
            </div>
        }
        @if (data.Courses.IsEmpty) { <p class="empty">Add a course to see progress.</p> }
    </section>
</div>

@code {
    private string? error;
    private void Toggle(Guid id) => error = Store.Change(d => Changes.ToggleAssignment(d, id))
        is Fail<HubData> f ? f.Error : null;
}
