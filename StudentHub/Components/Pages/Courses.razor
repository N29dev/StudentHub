@page "/courses"
@attribute [Authorize(Roles = Roles.Student)]
@inherits CampusPage
<PageTitle>Courses &amp; GPA · StudentHub</PageTitle>

<header class="page-head"><div><h1>Courses &amp; GPA</h1><p>View your lecturer-assigned grades and academic record.</p></div><a class="button" href="/predict">Grade prediction</a></header>
@{
    var data = Campus.StudentData(UserId);
    var graded = data.Courses.Where(c => c.Grade.HasValue).ToArray();
}
<div class="stats three">
    <Stat Label="Current GPA" Value="@(data.Courses.Gpa()?.ToString("0.00") ?? "—")" Detail="4.0 scale" />
    <Stat Label="Graded credits" Value="@graded.Sum(c => c.Credits).ToString()" Detail="included in GPA" />
    <Stat Label="Total credits" Value="@data.Courses.Sum(c => c.Credits).ToString()" Detail="@($"{data.Courses.Length} courses")" />
</div>
<section class="panel"><div class="section-head"><h2>My courses</h2><small>Grades are managed by lecturers.</small></div>
    <div class="table-wrap"><table><thead><tr><th>Course</th><th>Credits</th><th>Grade (%)</th><th>Points</th></tr></thead><tbody>
        @foreach (var c in data.Courses.OrderBy(c => c.Name))
        {
            <tr @key="c.Id"><td><strong>@c.Name</strong></td><td>@c.Credits</td><td>@(c.Grade?.ToString("0.##") ?? "—")</td>
                <td>@(c.Grade is decimal g ? Academics.GradePoints(g).ToString("0.00") : "—")</td></tr>
        }
    </tbody></table></div>
    @if (data.Courses.IsEmpty) { <p class="empty">No courses yet.</p> }
</section>
<section class="panel"><h2>How GPA is calculated</h2>
    <p class="muted">Sum of (grade points × credits) divided by graded credits. Ungraded courses are excluded. This is an example 4.0 grading scale.</p>
    <div class="table-wrap"><table class="scale"><thead><tr><th>Percentage</th>@foreach (var t in thresholds) { <th>@(t)+</th> }<th>0–49</th></tr></thead>
        <tbody><tr><th>Points</th>@foreach (var t in thresholds) { <td>@Academics.GradePoints(t).ToString("0.00")</td> }<td>0.00</td></tr></tbody></table></div>
</section>
@code {
    private static readonly int[] thresholds = [95, 90, 85, 80, 75, 70, 65, 60, 55, 50];
}
