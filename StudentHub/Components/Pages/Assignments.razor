@page "/assignments"
@attribute [Authorize(Roles = Roles.Student)]
@inherits CampusPage
<PageTitle>Assignments · StudentHub</PageTitle>

<header class="page-head"><div><h1>Assignments</h1><p>Tasks published for your academic group.</p></div></header>
<Notice Message="@error" />
@{
    var data = Campus.StudentData(UserId);
    var today = DateOnly.FromDateTime(DateTime.Today);
    Func<Assignment, bool> predicate = filter switch
    {
        "active" => a => !a.Completed,
        "done" => a => a.Completed,
        "overdue" => a => a.Status(today) == AssignmentStatus.Overdue,
        _ => _ => true
    };
    var filtered = data.Assignments.Filter(predicate, search).Where(a => courseFilter == Guid.Empty || a.CourseId == courseFilter);
    var items = sort == "priority" ? filtered.Plan(today).Concat(filtered.Where(a => a.Completed).OrderBy(a => a.Due))
        : filtered.OrderBy(a => a.Completed).ThenBy(a => a.Due);
}
<section class="panel">
    <div class="filters">
        <label>Search<input placeholder="Find an assignment" @bind="search" @bind:event="oninput" /></label>
        <label>Status<select @bind="filter"><option value="all">All</option><option value="active">Active</option>
            <option value="done">Completed</option><option value="overdue">Overdue</option></select></label>
        <label>Course<select @bind="courseFilter"><option value="@Guid.Empty">All courses</option>
            @foreach (var c in data.Courses) { <option value="@c.Id">@c.Name</option> }</select></label>
        <label>Sort<select @bind="sort"><option value="due">Due date</option><option value="priority">Smart priority</option></select></label>
    </div>
    <TaskList Items="@items.ToArray()" Data="@data" Today="@today" Toggle="Toggle" />
</section>
@code {
    private Guid courseFilter;
    private string search = "", filter = "all", sort = "priority";
    private string? error;
    private void Toggle(Guid id) => error = Campus.Toggle(UserId, id) is Fail<bool> f ? f.Error : null;
}
